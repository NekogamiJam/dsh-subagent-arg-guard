{
  "name": "dsh-subagent-arg-guard",
  "version": "0.3.6",
  "description": "Retry known subagent model-argument errors once using the original default route, and control the two subagent tools independently.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NekogamiJam/dsh-subagent-arg-guard.git"
  },
  "homepage": "https://github.com/NekogamiJam/dsh-subagent-arg-guard#readme",
  "bugs": { "url": "https://github.com/NekogamiJam/dsh-subagent-arg-guard/issues" },
  "keywords": ["dsh-plugin", "deepseek-harness", "subagent"],
  "publishConfig": { "registry": "https://registry.npmjs.org/", "access": "public" },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./guard": "./lib/guard.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "cordis.patch.yml", "icon.svg", "locale", "README.en-US.md", "TESTING.zh-CN.md", "LICENSE"],
  "scripts": { "test": "node --experimental-vm-modules test/all.test.mjs", "check": "node --check lib/guard.js && node --check lib/index.js && node --check lib/runtime.js && node --check lib/client.js && node --check lib/access.js" },
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.1 <0.3.0-0 || 0.2.3-alpha.1 || 0.2.3-alpha.2" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-ui-settings"] }
  },
  "dependencies": { "@deepseek-ai/schemastery": "3.18.4" },
  "peerDependencies": {
    "@deepseek-ai/dsh-app-boot": ">=0.2.2-rc.1 <0.3.0-0 || 0.2.3-alpha.1 || 0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-rc.1 <0.3.0-0 || 0.2.3-alpha.1 || 0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.1 <0.3.0-0 || 0.2.3-alpha.1 || 0.2.3-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-app-boot": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true }
  },
  "license": "MIT"
}
